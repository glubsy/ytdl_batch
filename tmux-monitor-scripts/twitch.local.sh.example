# Twitch livestream local configuration.
DOWNLOAD_TARGET="${HOME}/livestreams"
# save_livestream.py path for Twitch usage (wrapper script around streamlink)
# https://github.com/mrwnwttk/livestream_scripts
SL_PATH="${SL_PATH:-}"
if [ -z "${SL_PATH}" ]; then
	SL_PATH="${HOME}/bin/save_livestream"
fi
# Assuming streamlink is installed in a python venv at ${HOME}/venv
if [ -d "${HOME}/venv" ] && [ -f "${HOME}/venv/bin/streamlink" ]; then
	SL_CMD="source ${HOME}/venv/bin/activate && python ${SL_PATH}"
else
	SL_CMD="python3 ${SL_PATH}"
fi

# Define the broadcasters that should be monitored for here.
TTV_STREAMER_INDEX=(
	"your_streamer"
)

# Define the broadcasters we should know about here.
# Each entry: dir|author|url|displ
# dir: target directory name
# author: for the destination filename, used by the downloader
# URL: URL for downloader
# disp: display name for the tmux pane
declare -gA TTV_STREAMERS
TTV_STREAMERS["your_streamer"]="your_streamer|your_streamer|https://www.twitch.tv/your_streamer|your_streamer"
